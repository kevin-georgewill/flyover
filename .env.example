# Base URL of the Flyover backend API (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public base used to build shareable referral links. Defaults to <API_BASE>/r
# In production this should be a short public domain that proxies to GET /api/v1/r/:code
NEXT_PUBLIC_REFERRAL_BASE_URL=http://localhost:4000/api/v1/r

# true  = run the whole UI against the built-in mock API (no backend needed)
# false = talk to the real backend
NEXT_PUBLIC_USE_MOCKS=false

# Minimum withdrawal shown in the UI. Must match the backend (currently NGN 5,000).
NEXT_PUBLIC_MIN_WITHDRAWAL=5000
