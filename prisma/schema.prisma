generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AFFILIATE
  BUSINESS
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CampaignStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ENDED
}

enum CampaignAccess {
  OPEN
  APPROVAL
  INVITATION
}

enum CampaignAction {
  CPS
  CPL
  CPR
  CPA
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum AttributionModel {
  FIRST_CLICK
  LAST_CLICK
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  INVITED
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
  DISPUTED
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  REVERSED
}

enum LedgerType {
  PENDING_CREDIT
  PENDING_DEBIT
  AVAILABLE_CREDIT
  AVAILABLE_DEBIT
  WITHDRAWAL_RESERVED
  WITHDRAWAL_RELEASED
  WITHDRAWN
  REVERSAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  GENERAL
  BUSINESS_VERIFICATION
  CAMPAIGN
  APPLICATION
  CONVERSION
  COMMISSION
  WITHDRAWAL
}

model User {
  id              String            @id @default(cuid())
  fullName        String
  email           String            @unique
  phone           String?
  passwordHash    String
  role            Role
  isEmailVerified Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  affiliate       AffiliateProfile?
  business        BusinessProfile?
  sessions        RefreshSession[]
  notifications   Notification[]
  auditLogs       AuditLog[]        @relation("AuditActor")
}

model RefreshSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AffiliateProfile {
  id                  String                @id @default(cuid())
  userId              String                @unique
  bio                 String?
  website             String?
  socialLinks         Json?
  promotionalChannels String[]              @default([])
  interests           String[]              @default([])
  audienceSize        Int?
  country             String                @default("Nigeria")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        CampaignApplication[]
  referrals           Referral[]
  conversions         Conversion[]
  commissions         Commission[]
  walletEntries       WalletEntry[]
  withdrawals         Withdrawal[]
}

model BusinessProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  name               String
  description        String?
  website            String?
  country            String         @default("Nigeria")
  registrationNumber String?
  verificationNotes  String?
  status             BusinessStatus @default(PENDING)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  campaigns          Campaign[]
}

model Product {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  description    String?
  price          Decimal?        @db.Decimal(14, 2)
  currency       String          @default("NGN")
  category       String?
  imageUrl       String?
  destinationUrl String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]

  @@index([businessId])
}

model Campaign {
  id               String                @id @default(cuid())
  businessId       String
  productId        String?
  name             String
  description      String
  instructions     String?
  category         String?
  country          String                @default("Nigeria")
  action           CampaignAction        @default(CPS)
  commissionType   CommissionType
  commissionValue  Decimal               @db.Decimal(14, 2)
  currency         String                @default("NGN")
  access           CampaignAccess        @default(OPEN)
  attributionModel AttributionModel      @default(LAST_CLICK)
  attributionDays  Int                   @default(30)
  validationDays   Int                   @default(14)
  startsAt         DateTime?
  endsAt           DateTime?
  destinationUrl   String?
  status           CampaignStatus        @default(DRAFT)
  rejectionReason  String?
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  business         BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product          Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  applications     CampaignApplication[]
  referrals        Referral[]
  conversions      Conversion[]
  commissions      Commission[]

  @@index([status, category, country])
  @@index([businessId])
}

model CampaignApplication {
  id          String            @id @default(cuid())
  campaignId  String
  affiliateId String
  status      ApplicationStatus @default(PENDING)
  message     String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate   AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([campaignId, affiliateId])
}

model Referral {
  id          String           @id @default(cuid())
  code        String           @unique
  campaignId  String
  affiliateId String
  createdAt   DateTime         @default(now())
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clicks      Click[]
  conversions Conversion[]

  @@unique([campaignId, affiliateId])
}

model Click {
  id         String   @id @default(cuid())
  referralId String
  clickedAt  DateTime @default(now())
  source     String?
  userAgent  String?
  ipHash     String?
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, clickedAt])
}

model Conversion {
  id                String           @id @default(cuid())
  campaignId        String
  affiliateId       String
  referralId        String
  externalReference String
  customerReference String?
  amount            Decimal          @db.Decimal(14, 2)
  currency          String           @default("NGN")
  status            ConversionStatus @default(PENDING)
  submittedById     String
  reviewedById      String?
  rejectionReason   String?
  evidenceUrl       String?
  convertedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  campaign          Campaign         @relation(fields: [campaignId], references: [id])
  affiliate         AffiliateProfile @relation(fields: [affiliateId], references: [id])
  referral          Referral         @relation(fields: [referralId], references: [id])
  commission        Commission?

  @@unique([campaignId, externalReference])
  @@index([affiliateId, status])
}

model Commission {
  id               String           @id @default(cuid())
  conversionId     String           @unique
  campaignId       String
  affiliateId      String
  grossAmount      Decimal          @db.Decimal(14, 2)
  commissionAmount Decimal          @db.Decimal(14, 2)
  currency         String           @default("NGN")
  status           CommissionStatus @default(PENDING)
  availableAt      DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  conversion       Conversion       @relation(fields: [conversionId], references: [id])
  campaign         Campaign         @relation(fields: [campaignId], references: [id])
  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
}

model WalletEntry {
  id            String           @id @default(cuid())
  affiliateId   String
  type          LedgerType
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("NGN")
  referenceType String
  referenceId   String
  description   String
  createdAt     DateTime         @default(now())
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@unique([type, referenceType, referenceId])
  @@index([affiliateId, createdAt])
}

model Withdrawal {
  id               String           @id @default(cuid())
  affiliateId      String
  amount           Decimal          @db.Decimal(14, 2)
  currency         String           @default("NGN")
  status           WithdrawalStatus @default(PENDING)
  bankName         String
  accountName      String
  accountNumber    String
  adminNote        String?
  paymentReference String?
  reviewedById     String?
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}
