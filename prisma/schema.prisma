generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AFFILIATE
  BUSINESS
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CampaignStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ENDED
}

enum CampaignAccess {
  OPEN
  APPROVAL
  INVITATION
  PRIVATE
}

enum CampaignAction {
  CPS
  CPL
  CPR
  CPA
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponRedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum CompensationModel {
  PERFORMANCE
  FIXED_FEE
  HYBRID
}

enum CreatorProfileStatus {
  ACTIVE
  PAUSED
}

enum CreatorDeliverableStatus {
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum CreatorPaymentStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum AffiliateProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProgramMembershipStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
}

enum IntegrationKind {
  PAYMENT
  ECOMMERCE
  TRACKING
  CONVERSION_REPORTING
}

enum IntegrationProvider {
  GENERIC_HMAC
  SHOPIFY
  WOOCOMMERCE
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum AttributionSource {
  REFERRAL
  COUPON
  REFERRAL_AND_COUPON
  ATTRIBUTION_WINDOW
  TRACKING_API
  WEBHOOK
}

enum AttributionTouchType {
  CONVERSION
  PAGE_VIEW
  CLICK
  LANDING
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT
}

enum CrmStage {
  DISCOVERED
  CONTACTED
  NEGOTIATING
  PARTNER
  INACTIVE
}

enum AttributionModel {
  FIRST_CLICK
  LAST_CLICK
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  INVITED
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
  DISPUTED
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  REVERSED
}

enum LedgerType {
  PENDING_CREDIT
  PENDING_DEBIT
  AVAILABLE_CREDIT
  AVAILABLE_DEBIT
  WITHDRAWAL_RESERVED
  WITHDRAWAL_RELEASED
  WITHDRAWN
  REVERSAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  GENERAL
  BUSINESS_VERIFICATION
  CAMPAIGN
  APPLICATION
  CONVERSION
  COMMISSION
  WITHDRAWAL
}

model User {
  id              String            @id @default(cuid())
  fullName        String
  email           String            @unique
  phone           String?
  passwordHash    String
  role            Role
  isEmailVerified Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  affiliate       AffiliateProfile?
  business        BusinessProfile?
  sessions        RefreshSession[]
  notifications   Notification[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  businessMemberships BusinessMember[]
  notificationPreference NotificationPreference?
}

model RefreshSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AffiliateProfile {
  id                  String                @id @default(cuid())
  userId              String                @unique
  bio                 String?
  website             String?
  socialLinks         Json?
  promotionalChannels String[]              @default([])
  interests           String[]              @default([])
  audienceSize        Int?
  country             String                @default("Nigeria")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        CampaignApplication[]
  referrals           Referral[]
  conversions         Conversion[]
  coupons             Coupon[]
  creatorProfile      CreatorProfile?
  programMemberships  ProgramMembership[]
  creatorDeliverables CreatorDeliverable[]
  creatorPayments     CreatorPayment[]
  crmRecords          BusinessAffiliateRecord[]
  attributionTouches  AttributionTouch[]
  commissions         Commission[]
  walletEntries       WalletEntry[]
  withdrawals         Withdrawal[]
}

model BusinessProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  name               String
  description        String?
  website            String?
  country            String         @default("Nigeria")
  registrationNumber String?
  verificationNotes  String?
  status             BusinessStatus @default(PENDING)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  campaigns          Campaign[]
  programs           AffiliateProgram[]
  members             BusinessMember[]
  integrations        ExternalIntegration[]
  crmRecords          BusinessAffiliateRecord[]
}

model Product {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  description    String?
  price          Decimal?        @db.Decimal(14, 2)
  currency       String          @default("NGN")
  category       String?
  imageUrl       String?
  destinationUrl String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]

  @@index([businessId])
}

model Campaign {
  id               String                @id @default(cuid())
  businessId       String
  productId        String?
  name             String
  description      String
  instructions     String?
  category         String?
  country          String                @default("Nigeria")
  action           CampaignAction        @default(CPS)
  compensationModel CompensationModel    @default(PERFORMANCE)
  commissionType   CommissionType?
  commissionValue  Decimal?              @db.Decimal(14, 2)
  fixedFeeAmount   Decimal?              @db.Decimal(14, 2)
  requiredDeliverables Int                @default(1)
  programId        String?
  currency         String                @default("NGN")
  access           CampaignAccess        @default(OPEN)
  attributionModel AttributionModel      @default(LAST_CLICK)
  attributionDays  Int                   @default(30)
  validationDays   Int                   @default(14)
  startsAt         DateTime?
  endsAt           DateTime?
  destinationUrl   String?
  status           CampaignStatus        @default(DRAFT)
  rejectionReason  String?
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  business         BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product          Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  applications     CampaignApplication[]
  referrals        Referral[]
  conversions      Conversion[]
  commissions      Commission[]
  coupons          Coupon[]
  program          AffiliateProgram?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  creatorDeliverables CreatorDeliverable[]
  creatorPayments  CreatorPayment[]
  attributionTouches AttributionTouch[]
  integrations      ExternalIntegration[]

  @@index([programId])
  @@index([status, category, country])
  @@index([businessId])
}

model CampaignApplication {
  id          String            @id @default(cuid())
  campaignId  String
  affiliateId String
  status      ApplicationStatus @default(PENDING)
  message     String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate   AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([campaignId, affiliateId])
}

model Referral {
  id          String           @id @default(cuid())
  code        String           @unique
  campaignId  String
  affiliateId String
  createdAt   DateTime         @default(now())
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clicks      Click[]
  conversions Conversion[]

  @@unique([campaignId, affiliateId])
}

model Click {
  id         String   @id @default(cuid())
  referralId String
  clickedAt  DateTime @default(now())
  source     String?
  userAgent  String?
  ipHash     String?
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, clickedAt])
}

model Conversion {
  id                String           @id @default(cuid())
  campaignId        String
  affiliateId       String
  referralId        String?
  couponId          String?
  integrationId     String?
  attributionSource AttributionSource @default(REFERRAL)
  attributionEvidence Json?
  externalReference String
  customerReference String?
  amount            Decimal          @db.Decimal(14, 2)
  currency          String           @default("NGN")
  status            ConversionStatus @default(PENDING)
  submittedById     String
  reviewedById      String?
  rejectionReason   String?
  evidenceUrl       String?
  convertedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  campaign          Campaign         @relation(fields: [campaignId], references: [id])
  affiliate         AffiliateProfile @relation(fields: [affiliateId], references: [id])
  referral          Referral?         @relation(fields: [referralId], references: [id])
  coupon            Coupon?           @relation(fields: [couponId], references: [id])
  couponRedemption  CouponRedemption?
  verifications     ConversionVerification[]
  integration       ExternalIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  commission        Commission?

  @@unique([campaignId, externalReference])
  @@index([affiliateId, status])
}

model Commission {
  id               String           @id @default(cuid())
  conversionId     String           @unique
  campaignId       String
  affiliateId      String
  grossAmount      Decimal          @db.Decimal(14, 2)
  commissionAmount Decimal          @db.Decimal(14, 2)
  currency         String           @default("NGN")
  status           CommissionStatus @default(PENDING)
  availableAt      DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  conversion       Conversion       @relation(fields: [conversionId], references: [id])
  campaign         Campaign         @relation(fields: [campaignId], references: [id])
  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
}

model WalletEntry {
  id            String           @id @default(cuid())
  affiliateId   String
  type          LedgerType
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("NGN")
  referenceType String
  referenceId   String
  description   String
  createdAt     DateTime         @default(now())
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@unique([type, referenceType, referenceId])
  @@index([affiliateId, createdAt])
}

model Withdrawal {
  id               String           @id @default(cuid())
  affiliateId      String
  amount           Decimal          @db.Decimal(14, 2)
  currency         String           @default("NGN")
  status           WithdrawalStatus @default(PENDING)
  bankName         String
  accountName      String
  accountNumber    String
  adminNote        String?
  paymentReference String?
  reviewedById     String?
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model Coupon {
  id             String             @id @default(cuid())
  campaignId     String
  affiliateId    String
  code           String             @unique
  discountType   CouponDiscountType
  discountValue  Decimal            @db.Decimal(14, 2)
  maxRedemptions Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate      AffiliateProfile   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  conversions    Conversion[]
  redemptions    CouponRedemption[]

  @@index([campaignId, isActive])
  @@index([affiliateId])
}

model CouponRedemption {
  id           String     @id @default(cuid())
  couponId     String
  conversionId String     @unique
  redeemedAt   DateTime   @default(now())
  status       CouponRedemptionStatus @default(RESERVED)

  coupon       Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  conversion   Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@index([couponId, redeemedAt, status])
}

// Phase 11 — creator economy, verification and automation.
// Phase 12 — private programmes, external integrations, CRM and enterprise access.

model CreatorProfile {
  id             String               @id @default(cuid())
  affiliateId    String               @unique
  displayName    String
  bio            String?
  niches         String[]             @default([])
  country        String               @default("Nigeria")
  city           String?
  languages      String[]             @default([])
  portfolioUrl   String?
  mediaKitUrl    String?
  socialProfiles Json?
  audienceSize   Int?
  engagementRate Decimal?             @db.Decimal(7, 4)
  status         CreatorProfileStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  affiliate      AffiliateProfile     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([country, city, status])
  @@index([audienceSize])
}

model CreatorDeliverable {
  id            String                  @id @default(cuid())
  campaignId    String
  affiliateId   String
  title         String
  description   String?
  assetUrl      String
  contentType   String?
  status        CreatorDeliverableStatus @default(SUBMITTED)
  version       Int                     @default(1)
  reviewNotes   String?
  reviewedById  String?
  dueAt         DateTime?
  submittedAt   DateTime                @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  campaign      Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate     AffiliateProfile        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([campaignId, affiliateId])
  @@index([status, dueAt])
}

model CreatorPayment {
  id               String               @id @default(cuid())
  campaignId       String
  affiliateId      String
  amount           Decimal              @db.Decimal(14, 2)
  currency         String               @default("NGN")
  status           CreatorPaymentStatus @default(PENDING)
  paymentReference String?
  paymentProvider  String?
  adminNote        String?
  approvedById     String?
  paidAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate        AffiliateProfile     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([campaignId, affiliateId])
  @@index([status, createdAt])
}

model AffiliateProgram {
  id                    String                @id @default(cuid())
  businessId            String
  name                  String
  slug                  String                @unique
  description           String?
  status                AffiliateProgramStatus @default(DRAFT)
  requiresApproval      Boolean               @default(true)
  landingPageTitle      String?
  landingPageDescription String?
  brandColor            String?
  customFields          Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  business              BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships           ProgramMembership[]
  campaigns             Campaign[]

  @@index([businessId, status])
}

model ProgramMembership {
  id          String                  @id @default(cuid())
  programId   String
  affiliateId String
  status      ProgramMembershipStatus @default(PENDING)
  source      String                  @default("REGISTRATION_PAGE")
  answers     Json?
  appliedAt   DateTime                @default(now())
  reviewedAt  DateTime?
  reviewedById String?
  program     AffiliateProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  affiliate   AffiliateProfile        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([programId, affiliateId])
  @@index([affiliateId, status])
}

model BusinessMember {
  id          String            @id @default(cuid())
  businessId  String
  userId      String
  role        BusinessMemberRole @default(ANALYST)
  isActive    Boolean           @default(true)
  invitedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, isActive])
}

model ExternalIntegration {
  id                  String              @id @default(cuid())
  businessId          String
  campaignId          String?
  createdById         String
  name                String
  kind                IntegrationKind
  provider            IntegrationProvider @default(GENERIC_HMAC)
  status              IntegrationStatus   @default(ACTIVE)
  publicKey           String              @unique
  encryptedCredentials String?
  config              Json?
  allowedDomains      String[]            @default([])
  lastEventAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  business            BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign            Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  apiKeys             IntegrationApiKey[]
  webhookEvents       WebhookEvent[]
  conversions         Conversion[]
  verifications       ConversionVerification[]
  attributionTouches  AttributionTouch[]

  @@index([businessId, kind, status])
  @@index([campaignId])
}

model IntegrationApiKey {
  id            String             @id @default(cuid())
  integrationId String
  name          String
  keyPrefix     String
  keyHash       String             @unique
  scopes        String[]           @default([])
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime           @default(now())
  integration   ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, revokedAt])
}

model WebhookEvent {
  id                String            @id @default(cuid())
  integrationId     String
  externalEventId   String
  eventType         String
  authMethod        String            @default("WEBHOOK_HMAC")
  payload           Json
  signatureVerified Boolean           @default(false)
  status            WebhookEventStatus @default(RECEIVED)
  attempts          Int               @default(0)
  lastError         String?
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  verification     ConversionVerification?

  @@unique([integrationId, externalEventId])
  @@index([status, createdAt])
}

model ConversionVerification {
  id                String             @id @default(cuid())
  conversionId      String
  integrationId     String?
  webhookEventId    String?            @unique
  providerReference String?
  status            VerificationStatus @default(PENDING)
  evidence          Json?
  failureReason     String?
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  conversion        Conversion         @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  integration       ExternalIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  webhookEvent      WebhookEvent?      @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([conversionId, status])
}

model AttributionTouch {
  id            String               @id @default(cuid())
  externalEventId String?
  integrationId String?
  campaignId    String
  affiliateId   String?
  referralId    String?
  couponId      String?
  visitorHash   String
  touchType     AttributionTouchType
  source        String?
  occurredAt    DateTime             @default(now())
  metadata      Json?
  integration   ExternalIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  campaign      Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  affiliate     AffiliateProfile?    @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@unique([integrationId, externalEventId])
  @@index([campaignId, visitorHash, occurredAt])
  @@index([affiliateId, occurredAt])
}

model BusinessAffiliateRecord {
  id          String       @id @default(cuid())
  businessId  String
  affiliateId String
  stage       CrmStage     @default(DISCOVERED)
  tags        String[]     @default([])
  notes       String?
  lastContactAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([businessId, affiliateId])
  @@index([businessId, stage])
}


model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  inAppEnabled   Boolean  @default(true)
  emailEnabled   Boolean  @default(false)
  mutedTypes     NotificationType[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
